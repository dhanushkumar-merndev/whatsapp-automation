# =============================================================================
# Star Growth Hub — WhatsApp Automation Platform
# Copy this file to `.env.local` (local dev) and fill in every value.
# On Vercel, add the same keys under Project → Settings → Environment Variables.
# NEVER commit real values. Variables without NEXT_PUBLIC_ are server-only.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public HTTPS base URL of this deployment, no trailing slash.
# QStash calls back to  {NEXT_PUBLIC_APP_URL}/api/jobs/qstash
# Meta calls            {NEXT_PUBLIC_APP_URL}/api/webhooks/whatsapp
# Local dev: use a tunnel URL (e.g. cloudflared / ngrok) or a Vercel preview URL.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# development | production
# production enforces HTTPS-only CRM webhooks and stricter checks.
APP_ENV=development

# 32 random bytes, base64. Encrypts CRM webhook secrets stored in the database (AES-256-GCM).
# Generate:  openssl rand -base64 32
# Changing it later makes existing stored CRM secrets unreadable (re-enter them).
APP_ENCRYPTION_KEY=

# Random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
# to /api/cron/sweep (retries, retention cleanup, usage snapshots).
# Generate:  openssl rand -hex 32
CRON_SECRET=

# -----------------------------------------------------------------------------
# Supabase  (Dashboard → Project Settings → API / Database)
# -----------------------------------------------------------------------------
# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (or legacy "anon" key). Safe for the browser — RLS protects all data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (or legacy "service_role" key). SERVER ONLY — bypasses RLS.
# Used by webhooks, QStash workers and admin user management.
SUPABASE_SECRET_KEY=

# Postgres connection string, used ONLY by `pnpm db:migrate` to apply SQL migrations.
# Dashboard → Connect → "Session pooler" URI, e.g.
# postgresql://postgres.abcdefghijkl:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# First owner account, created by `pnpm bootstrap:owner` (public sign-up stays disabled;
# other admins are added from Settings → Users). Login can be an email or a login ID
# such as "Gayathri@2026". MFA enrollment is still mandatory on first sign-in.
# Remove BOOTSTRAP_OWNER_PASSWORD from this file after the owner has been created.
BOOTSTRAP_OWNER_LOGIN=
BOOTSTRAP_OWNER_PASSWORD=

# -----------------------------------------------------------------------------
# Meta WhatsApp Cloud API  (developers.facebook.com → your App → WhatsApp)
# -----------------------------------------------------------------------------
# App → Settings → Basic → App Secret. Used to verify X-Hub-Signature-256 on webhooks.
META_APP_SECRET=

# Any random string you choose. Enter the SAME value in Meta → WhatsApp → Configuration
# → Webhook → "Verify token".  Generate:  openssl rand -hex 24
META_WEBHOOK_VERIFY_TOKEN=

# Permanent System User access token (Business Settings → System users) with
# whatsapp_business_messaging + whatsapp_business_management permissions.
# Never exposed to the browser.
META_ACCESS_TOKEN=

# Graph API version used for all calls.
META_GRAPH_API_VERSION=v23.0

# WhatsApp Business Account ID (WABA ID). Webhook events from any other WABA are rejected.
META_WABA_ID=

# Phone number ID (NOT the phone number itself) of the business number.
# Webhook events for other phone numbers are ignored.
META_PHONE_NUMBER_ID=

# -----------------------------------------------------------------------------
# Upstash QStash  (console.upstash.com → QStash)
# -----------------------------------------------------------------------------
# QStash endpoint shown in the console (region-specific for newer accounts).
QSTASH_URL=https://qstash.upstash.io

# Token used to publish delayed jobs.
QSTASH_TOKEN=

# Signing keys used to verify that callbacks really come from QStash.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# -----------------------------------------------------------------------------
# Upstash Redis  (console.upstash.com → Redis → your database → REST API)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# OPTIONAL — Upstash Developer API, for provider-reported Redis usage stats.
# If left empty, the Usage page shows locally counted ESTIMATES (clearly labelled).
# console.upstash.com → Account → Management API
# -----------------------------------------------------------------------------
UPSTASH_MANAGEMENT_EMAIL=
UPSTASH_MANAGEMENT_API_KEY=
UPSTASH_REDIS_DATABASE_ID=
